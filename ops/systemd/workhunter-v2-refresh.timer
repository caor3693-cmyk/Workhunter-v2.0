# User timer template; no installation, domain or firewall action is implied.
[Unit]
Description=Workhunter v2 six-hour natural schedule

[Timer]
OnCalendar=*-*-* 00,06,12,18:00:00 Asia/Shanghai
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=workhunter-v2-refresh.service

[Install]
WantedBy=timers.target
